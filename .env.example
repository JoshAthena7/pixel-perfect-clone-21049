# ATLAS Platform — required environment variables
# Copy to .env.local and fill in real values. Do NOT commit secrets.
# Browser-exposed vars must be prefixed VITE_; server-only vars must not be.

# --- Lovable Cloud / Supabase (managed) ---
# Browser
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-anon-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Server (TanStack server functions, /api/public/hooks/*, cron handlers)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-anon-key>
# Service role — privileged, server-only. Managed by Lovable Cloud; not user-set.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Lovable AI Gateway ---
# Used by every IRIS / ORACLE classifier / brief-generator call.
LOVABLE_API_KEY=<lovable-ai-gateway-key>

# --- Cron / public-hook authentication ---
# Required by /api/public/hooks/oracle-scraper, oracle-classifier,
# oracle-promoter, iris-daily-monitor, monitor-*-feeds, refresh-intelligence-graph.
# pg_cron jobs must send header: x-cron-secret: $CRON_HOOK_SECRET
CRON_HOOK_SECRET=<long-random-string>

# --- Optional integration stubs (not yet wired) ---
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=
